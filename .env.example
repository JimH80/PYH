APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_LOG_PATH=storage/logs/application.log

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plan_your_holiday_v16
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Local and test database changes are allowed. Higher environments require
# their own explicit, short-lived deployment confirmation.
ALLOW_PRODUCTION_DATABASE_CHANGES=false
CONFIRM_STAGING_DATABASE_CHANGES=false
