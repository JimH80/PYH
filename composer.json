{
    "name": "jimh80/plan-your-holiday-v16",
    "description": "Clean consolidated rebuild of the Plan Your Holiday platform.",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PYH\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PYH\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "check": [
            "@test",
            "@analyse"
        ]
    }
}
